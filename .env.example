# Copy to .env and fill in.
DISCORD_TOKEN=
# HenrikDev Valorant API key (free Basic key from the HenrikDev Discord, see docs.henrikdev.xyz).
# The main data source: ranks, recent games and form, party, usual agents, and settling every bet.
HENRIK_API_KEY=
# Optional backup for when HenrikDev is down: a tracker.gg API key. Leave empty to skip tracker.gg.
TRACKER_API_KEY=

# Your server's ID: commands show up instantly there (global sync can take ~1h).
GUILD_ID=

# Optional tuning
STARTING_BALANCE=1000
DAILY_AMOUNT=50
MIN_BET=10
POLL_SECONDS=60
MATCH_TIMEOUT_HOURS=3
DB_PATH=valbet.db

# Read players' Discord Valorant status (needs Presence + Server Members intents). 0 to turn off.
PRESENCE_TRACKING=1
# Open betting automatically when a linked player's status shows a match starting. 0 to turn off.
AUTO_OPEN=1
# Seconds betting stays open after an automatic open (it also closes as soon as round 1 ends)
AUTO_OPEN_WINDOW_SECONDS=75

# Where the Overwolf app reports games (127.0.0.1 only unless DASHBOARD_HOST is set). Each player gets their address with /overwolf-link.
DASHBOARD_PORT=8787
# Leave empty to use a key the bot generates and stores itself
DASHBOARD_TOKEN=
