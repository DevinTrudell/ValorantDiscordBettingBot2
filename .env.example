# Copy to .env and fill in.
DISCORD_TOKEN=
# HenrikDev Valorant API key (free Basic key from the HenrikDev Discord, see docs.henrikdev.xyz).
# The main data source: ranks, recent games and form, party, usual agents, and settling every bet.
HENRIK_API_KEY=
# Optional backup for when HenrikDev is down: a tracker.gg API key. Leave empty to skip tracker.gg.
TRACKER_API_KEY=

# Your home server's ID. The bot works in any number of servers, each with its own coins, links and bets in
# its own database file (valbet-<server id>.db). The home server keeps DB_PATH itself, and is the only one
# where Win/Loss pays straight from Discord statuses, /overwolf-link works and the status log is kept.
# Don't change it once set: the existing balances belong to this server.
GUILD_ID=

# Optional tuning
STARTING_BALANCE=1000
DAILY_AMOUNT=50
# Coins paid to a linked player for each ace (all 5 enemies in one round)
ACE_COINS=250
# Coins paid to a linked player for each kill
KILL_COINS=5
MIN_BET=10
POLL_SECONDS=60
MATCH_TIMEOUT_HOURS=3
DB_PATH=valbet.db

# Read players' Discord Valorant status (needs Presence + Server Members intents). 0 to turn off.
PRESENCE_TRACKING=1
# Open betting automatically when a linked player's status shows a match starting. 0 to turn off.
AUTO_OPEN=1
# Seconds betting stays open after an automatic open (it also closes as soon as round 1 ends)
AUTO_OPEN_WINDOW_SECONDS=100
# Seconds before the same player can auto-open again (debounces status flaps; keep well under one game)
AUTO_OPEN_COOLDOWN_SECONDS=120

# Where the Overwolf app reports games (127.0.0.1 only unless DASHBOARD_HOST is set). Each player gets their address with /overwolf-link.
DASHBOARD_PORT=8787
# Leave empty to use a key the bot generates and stores itself
DASHBOARD_TOKEN=

# Overwatch session bets are unfinished and off by default; 1 turns them on
OVERWATCH=0

# --- Headless Riot presence watcher (optional; see SETUP_PRESENCE.md) ---
# Opens betting for friends' Valorant games from the server, no install on their PCs. Off unless you run
# riot_presence.py with a session file in place.
RIOT_SESSION_FILE=riot_session.json
BOT_DASHBOARD_URL=http://127.0.0.1:8787/api/overwolf
# Don't re-fire for the same player within this many seconds (one game is longer than this)
RIOT_PRESENCE_REOPEN_SECONDS=900
# Only set if your region's chat host ever moves; otherwise leave empty
RIOT_CHAT_HOST=
# 1 = log the handshake and raw presence for debugging
RIOT_PRESENCE_DEBUG=0

# --- Many servers ---
# Daily coins only go to people who used a command or bet in the last this-many days
ACTIVE_DAYS=14
# /give limits (stop extra accounts funnelling their free coins to one): per person per day, both ways
GIVE_DAILY_LIMIT=500
GIVE_MIN_ACCOUNT_DAYS=30
GIVE_MIN_MEMBER_DAYS=7
# Where PRIVACY.md is published (shown by /privacy; Discord asks for one when verifying a bot in 75+ servers)
PRIVACY_URL=
# Discord apps that really are Valorant; a status from any other app named "VALORANT" is ignored
VALORANT_APP_IDS=1443350165678198935,700136079562375258
